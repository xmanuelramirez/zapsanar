{
  // Sitio 100% estatico: no hay Worker con codigo, solo assets. Por eso no se
  // declara "main". Las peticiones a assets no ejecutan Worker, asi que no
  // cuentan contra el limite diario de peticiones del plan gratuito.
  "name": "zapsanar",
  "compatibility_date": "2026-08-10",
  "assets": {
    "directory": "./dist",
    // Devuelve index.html con 200 en cualquier ruta que no sea un archivo.
    // La app vive en un solo lienzo, pero esto evita un 404 si alguien llega
    // con una ruta vieja o mal copiada.
    "not_found_handling": "single-page-application"
  }
}
